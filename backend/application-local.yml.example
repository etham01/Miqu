# ============================================================
#  本地配置模板
#
#  在新机器上首次启动时：
#     cp application-local.yml.example src/main/resources/application-local.yml
#  然后把下面的口令改成你本机 MySQL 的。
#
#  src/main/resources/application-local.yml 已被 .gitignore 排除，
#  真实凭据不会被提交；这个模板文件本身可以放心提交。
# ============================================================

spring:
  datasource:
    # 保留 ${环境变量:默认值} 的写法，否则设了环境变量也覆盖不了（见 local 文件里的说明）
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:这里填你的 MySQL 口令}

# 数据库不在本机、或端口 / 库名不同时，用环境变量即可，不必改文件：
#   DB_HOST / DB_PORT / DB_NAME / DB_USERNAME / DB_PASSWORD
#
# 或者在这里覆盖 url：
#   spring:
#     datasource:
#       url: jdbc:mysql://192.168.1.10:3306/miqu?serverTimezone=Asia/Shanghai&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
